@startuml pvision-use-case-overview
!pragma layout smetana
title Pvision High-Level Use Case Diagram
left to right direction
skinparam packageStyle rectangle

actor "Unauthenticated Visitor" as Visitor
actor "Authenticated User" as User
actor "Super Administrator" as Admin
actor "Common Role" as Common
actor "Trial Role" as Trial

User <|-- Admin
User <|-- Common
User <|-- Trial

rectangle "Pvision Project Management Platform" {
  package "Auth Service" as Auth {
    usecase "Manage Authentication and Sessions" as UC_Auth
    usecase "Register Account" as UC_Register
  }

  package "Project Service" as Project {
    usecase "Manage Project Collaboration" as UC_Project
    usecase "Manage Tasks and Progress" as UC_Task
    usecase "Manage Project Files and Members" as UC_ProjectAssets
  }

  package "Workflow Service" as Workflow {
    usecase "Manage Workflow Models and Forms" as UC_WorkflowDesign
    usecase "Start Processes and Handle Approvals" as UC_Approval
    usecase "Manage Personal Workflow Tasks" as UC_WorkflowTasks
  }

  package "System Service" as System {
    usecase "Manage Users and Access" as UC_Access
    usecase "Manage Organization and Reference Data" as UC_Org
    usecase "Manage Operations and Auditing" as UC_Ops
    usecase "Manage Personal Profile" as UC_Profile
  }

  package "Job Service" as Job {
    usecase "Manage Scheduled Jobs and Logs" as UC_Schedule
  }
}

Visitor --> UC_Auth
Visitor --> UC_Register
User --> UC_Project
User --> UC_Task
User --> UC_ProjectAssets
User --> UC_Approval
User --> UC_WorkflowTasks
User --> UC_Profile

Admin --> UC_Access
Admin --> UC_Org
Admin --> UC_Ops
Admin --> UC_Schedule

note right of Trial
Valid role defined in the source database:
trial account with read-only access.
Visible use cases are controlled by menu permissions.
end note

note bottom of User
Project owners and approvers are business-context identities,
not fixed system roles defined in sys_role.
end note
@enduml
